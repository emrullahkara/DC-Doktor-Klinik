# Uygulamanın bağlandığı kullanıcı (RLS'e tabi, tablo sahibi değil)
DATABASE_URL=postgres://dc_app:dc_app_parola@localhost:5432/dc_klinik
# Migration'ları çalıştıran tablo sahibi kullanıcı
MIGRATION_DATABASE_URL=postgres://dc_owner:dc_owner_parola@localhost:5432/dc_klinik
# En az 32 karakterlik rastgele bir değer kullanın
JWT_SECRET=degistirin-en-az-32-karakter-rastgele-deger
PORT=3000
# Hassas alan (kimlik no) şifreleme anahtarı: openssl rand -base64 32 ile üretin, güvenli saklayın
ALAN_SIFRELEME_ANAHTARI=
# API bir ters vekil (nginx, yük dengeleyici) arkasındaysa aradaki vekil sayısı (örn. 1).
# Giriş deneme sınırı istemci IP'sini X-Forwarded-For'dan buna göre okur; doğrudan yayında boş bırakın.
TRUST_PROXY=
# Aynı IP'den saatte izin verilen kurum kaydı sayısı (varsayılan 5)
# KAYIT_SINIRI=5
