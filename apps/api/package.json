{
  "name": "@dc/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --env-file-if-exists=../../.env -r ts-node/register/transpile-only src/main.ts",
    "start": "node dist/src/main.js",
    "db:migrate": "node --env-file-if-exists=../../.env -r ts-node/register/transpile-only src/db/migrate-cli.ts",
    "test": "jest --runInBand"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "setupFiles": [
      "<rootDir>/test/env.ts"
    ],
    "testTimeout": 30000,
    "moduleNameMapper": {
      "^@dc/shared$": "<rootDir>/../../packages/shared/src"
    }
  },
  "dependencies": {
    "@dc/shared": "workspace:*",
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.6",
    "@node-rs/argon2": "2.2.1",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.4",
    "@types/pg": "8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "29.7.0",
    "supertest": "7.3.0",
    "ts-jest": "29.4.13",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  }
}
